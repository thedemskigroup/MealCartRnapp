{
  "expo": {
    "name": "Meal Cart",
    "slug": "meal-cart",
    "version": "1.0.3",
    "orientation": "portrait",
    "scheme": "mealcartrnmain",
    "owner": "the-demski-group",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": {
        "dark": "./assets/images/ios-app-icon.png",
        "light": "./assets/images/ios-app-icon.png",
        "tinted": "./assets/images/ios-app-icon.png"
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.app.mealcart",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "34QW5F2D72"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-app-icon.png",
        "monochromeImage": "./assets/images/android-app-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.app.mealcart"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withGoogleSignInIOS",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.107165390600-nmgglhb1s0gglvqmcln8kehr21cgpi5o"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Meal Cart accesses your photo library only when you choose a picture for one of your own meals or for your profile. For example, when you add \"Chicken Stir Fry\" to your meal list you can pick a saved photo of the dish so it appears on that meal's card.",
          "cameraPermission": "Meal Cart uses the camera only when you choose to take a picture for one of your own meals or for your profile. For example, you can photograph a dish you just cooked so it appears on that meal's card in your meal list.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c7a96f9-4a7e-48b1-9452-4e3e47c534f2"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3c7a96f9-4a7e-48b1-9452-4e3e47c534f2"
    }
  }
}
